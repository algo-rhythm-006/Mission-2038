FROM node:20-alpine

WORKDIR /app

# Copy root package files (dependencies shared with next.js and node server)
COPY package.json package-lock.json ./

# Install all dependencies (backend uses express, mongoose, socket.io, etc.)
RUN npm ci --omit=dev

# Copy only API server source files
COPY api/ ./api/
COPY .env ./

# Expose Node.js API port
EXPOSE 5000

# Start Express server
CMD ["node", "api/server.js"]
